generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  FREE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum MediaType {
  MOVIE
  SERIES
}

enum Plan {
  FREE
  BASIC
  PREMIUM
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  passwordHash       String
  name               String?
  role               Role               @default(USER)
  stripeCustomerId   String?            @unique
  subscriptionStatus SubscriptionStatus @default(FREE)
  lastProfileId      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  profiles           Profile[]
  watchProgress      WatchProgress[]
  watchlist          Watchlist[]
  subscriptions      Subscription[]
  paymentLogs        PaymentLog[]
}

model Profile {
  id            String          @id @default(cuid())
  userId        String
  name          String
  avatarUrl     String?
  isKidsProfile Boolean         @default(false)
  createdAt     DateTime        @default(now())
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchProgress WatchProgress[]
  watchlist     Watchlist[]
}

model Media {
  id            String          @id @default(cuid())
  title         String
  slug          String          @unique
  description   String
  type          MediaType
  thumbnailUrl  String
  bannerUrl     String
  trailerUrl    String?
  videoUrl      String?
  releaseYear   Int
  duration      Int?
  ageRating     String
  language      String          @default("Deutsch")
  tags          String[]        @default([])
  isPublished   Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  series        Series?
  genres        MediaGenre[]
  watchProgress WatchProgress[]
  watchlist     Watchlist[]
}

model Series {
  id          String   @id @default(cuid())
  mediaId     String   @unique
  title       String
  description String
  media       Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  seasons     Season[]
}

model Season {
  id           String    @id @default(cuid())
  seriesId     String
  seasonNumber Int
  title        String
  series       Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episodes     Episode[]

  @@unique([seriesId, seasonNumber])
}

model Episode {
  id            String          @id @default(cuid())
  seasonId      String
  title         String
  description   String
  episodeNumber Int
  duration      Int
  videoUrl      String
  thumbnailUrl  String
  isPublished   Boolean         @default(false)
  season        Season          @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  watchProgress WatchProgress[]

  @@unique([seasonId, episodeNumber])
}

model Genre {
  id    String       @id @default(cuid())
  name  String       @unique
  slug  String       @unique
  media MediaGenre[]
}

model MediaGenre {
  mediaId String
  genreId String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([mediaId, genreId])
}

model WatchProgress {
  id              String   @id @default(cuid())
  userId          String
  profileId       String
  mediaId         String
  episodeId       String?
  progressSeconds Int      @default(0)
  completed       Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  media           Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  episode         Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([profileId, mediaId, episodeId])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  profileId String
  mediaId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([profileId, mediaId])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  stripeSubscriptionId String             @unique
  plan                 Plan
  status               SubscriptionStatus
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PaymentLog {
  id            String   @id @default(cuid())
  userId        String?
  stripeEventId String   @unique
  type          String
  rawData       Json
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}
